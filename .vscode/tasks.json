{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build Project",
            "command": "/usr/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-Wall",
                "-Wextra",
                "-Werror",
                "/${workspaceFolder}/philosophers/philo.c",
                "/${workspaceFolder}/philosophers/philo_utils.c",
				"/${workspaceFolder}/philosophers/life_parse.c",
				"/${workspaceFolder}/philosophers/life_init.c",
				"/${workspaceFolder}/philosophers/routine_life_start.c",
				"/${workspaceFolder}/philosophers/routine.c",
				"/${workspaceFolder}/philosophers/time.c",
				"/${workspaceFolder}/philosophers/set_and_get.c",
				"/${workspaceFolder}/philosophers/synchronise.c",
				"/${workspaceFolder}/philosophers/check_philos.c",
				"/${workspaceFolder}/philosophers/clean_life.c",
				"-I./inc",
				"-L.",
				"-lft_malloc",
				"-o",
				"philo_debug.out"
            ],
            // "options": {
            //     "cwd": "${workspaceFolder}",
            //     "shell": {
            //         "executable": "bash",
            //         "args": ["-c"]
            //     }
            // },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}

